POSTGRES_USER=weam
POSTGRES_PASSWORD=weam_dev_local_only
POSTGRES_DB=weam_research
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+psycopg://weam:weam_dev_local_only@localhost:5433/weam_research
LOG_LEVEL=INFO

# Optional: comma-separated Groq API keys (works with 1, 2, 3, or however many you have),
# used in rotation so a rate-limited/exhausted key doesn't stall extraction.
# Leave blank to run with zero LLM extraction — the graph still gets populated from
# structured fields (category, decision-maker, checks) at no cost; only free-text
# entity/relationship extraction is skipped.
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
